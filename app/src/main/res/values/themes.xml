<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Window background matches the Compose paper colour, so there is no
         white flash between the system splash and the first Compose frame. -->
    <style name="Theme.Okane" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
    </style>

    <!-- Startup-only theme: styles the system splash window shown while the
         app process is starting (mandatory on Android 12+, back-ported below
         by the core-splashscreen library). Once the activity is ready,
         postSplashScreenTheme swaps back to the normal theme. -->
    <style name="Theme.Okane.Starting" parent="Theme.SplashScreen">
        <!-- Same paper background and cairn as the animated Compose splash. -->
        <item name="windowSplashScreenBackground">@color/paper</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Okane</item>
    </style>
</resources>
